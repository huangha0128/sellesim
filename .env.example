# ===== 海豚 eSIM Docker 部署配置 =====
# 复制本文件为 .env 并修改后生效：cp .env.example .env（Windows: copy .env.example .env）

# ---------- Caddy 反向代理 ----------
# 配置域名后自动申请 HTTPS（需域名已解析到本机）；留空则监听 80 端口纯 HTTP
CADDY_DOMAIN=

# ---------- 对外端口 ----------
# 后端 API 直连端口
SERVER_PORT=6501
# 管理后台直连端口（绕过 Caddy 时使用 http://<IP>:6500/backend/）
ADMIN_PORT=6500
# Caddy HTTP/HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443

# ---------- 后端环境变量 ----------
# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=your-jwt-secret-key-change-in-production

# ---- Tiger eSIM 合作伙伴 API（可选，留空则本地模拟下发）----
TIGER_CLIENT_ID=
TIGER_CLIENT_SECRET=
TIGER_BASE_URL=https://partner.tigeresims.com
TIGER_SMDP_ADDRESS=
# 已采购的卡片 ICCID 池，逗号分隔
TIGER_ICCIDS=
