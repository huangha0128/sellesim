# ===== 海豚 eSIM Docker 部署配置 =====
# 复制本文件为 .env 并修改后生效：cp .env.example .env（Windows: copy .env.example .env）

# ---------- 部署角色（双机负载均衡用）----------
# main   主服（新服）：全量栈 MySQL/Redis/后端/后台/官网/Caddy（默认，行为等同单机）
# edge   老服（出口节点）：仅部署一个后端实例，参与 /api 负载均衡，
#        由老服宿主 nginx 按 deploy/nginx/edge.conf 配置出口。edge 服的 .env 必须
#        把 MYSQL_HOST 填为主服公网 IP、MYSQL_DB_PORT=1513；其余密钥（JWT/ADMIN/
#        TIGER/SMTP/ALIPAY）需与主服完全一致，token 才能互通。
DEPLOY_ROLE=main
# edge 后端容器名（可选，默认 sellsim-server-edge）
# EDGE_CONTAINER=sellsim-server-edge
# edge 后端是否关闭 webhook 回调重试：edge 设 false，把重试职责留给主服，避免重复回调
ENABLE_WEBHOOK_RETRY=true

# ---------- Caddy 反向代理 ----------
# 配置域名后启用 HTTPS（使用手动生成的证书）；留空则监听 80 端口纯 HTTP
# 注意：证书仅覆盖该域名（如 www.bjyyxx.com），请使用证书实际包含的域名
CADDY_DOMAIN=

# 出口代理模式（可选）：设置后本机 Caddy 仅终止 TLS，把所有流量反代到该地址。
# 用于双机负载均衡场景：老服作为备案域名出口，后端承载在主服。例如 CADDY_UPSTREAM=http://<主服IP>
# 留空则维持原逻辑（本机分发 /api、/backend、/open-api、官网静态）。
# CADDY_UPSTREAM=

# 手动生成的证书目录（宿主机路径，默认 /serve/nginx/cert）
# 对应 certbot 的 /etc/letsencrypt 挂载，证书位于 ${CERT_DIR}/live/<域名>/
# 例如 /serve/nginx/cert/live/www.bjyyxx.com/fullchain.pem
CERT_DIR=/serve/nginx/cert

# 证书文件在容器内的路径（可选，默认按 certbot 目录结构自动拼接：
#   /etc/caddy/cert/live/<域名>/fullchain.pem 与 privkey.pem）
# 若证书非标准路径，可取消注释手动指定
# CADDY_CERT_FILE=/etc/caddy/cert/live/www.bjyyxx.com/fullchain.pem
# CADDY_KEY_FILE=/etc/caddy/cert/live/www.bjyyxx.com/privkey.pem

# ---------- 对外端口 ----------
# 后端 API 直连端口
SERVER_PORT=6501
# 管理后台直连端口（绕过 Caddy 时使用 http://<IP>:6500/backend/）
ADMIN_PORT=6500
# 伙伴门户直连端口（绕过 Caddy 时使用 http://<IP>:6510/partner/）
PARTNER_PORT=6510
# Caddy HTTP/HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443

# ---------- MySQL 数据库 ----------
# 数据库主机：默认 mysql（compose 内置容器服务名）。
# 改用外部云 MySQL：填云库 IP/域名，并删除下方 COMPOSE_PROFILES 行以关闭内置容器。
# 首次启动自动创建数据库与账号（仅内置容器时有效）；外部云库需自行建库/建账号。
MYSQL_HOST=mysql
# 应用连接数据库所用端口（内置容器恒为 3306；云库非 3306 时按需改为云库端口）
MYSQL_DB_PORT=3306
# MySQL 对外（主机端口）映射：供老服 edge 后端跨公网连接主服数据库。
# edge 服的 .env 里 MYSQL_HOST=<主服IP>、MYSQL_DB_PORT=1513。主服默认监听 0.0.0.0:1513，
# 新服安全组/防火墙应仅放行老服 IP，其它来源拒绝。若要仅本机可达，把 MYSQL_EXT_BIND 改 127.0.0.1。
MYSQL_EXT_BIND=0.0.0.0
MYSQL_EXT_PORT=1513
# Redis 对外（主机端口）映射：默认仅本机可达；若需老服后端共享套餐缓存，
# 把 REDIS_EXT_BIND 改 0.0.0.0 并在新服放行老服 IP。（非必须，留空走内存缓存降级）
REDIS_EXT_BIND=127.0.0.1
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=sellsim
MYSQL_USER=sellsim
MYSQL_PASSWORD=change-me-sellsim-password
# 内置 MySQL 容器开关：保留本行=启动内置容器（默认）；改用外部云库时删除本行
COMPOSE_PROFILES=internal-mysql

# ---------- 后端环境变量 ----------
# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=your-jwt-secret-key-change-in-production

# ---- 支付宝支付配置（可选，不配置则使用 config.ts 中的默认值）----
# 支付宝应用 ID
# ALIPAY_APP_ID=202100xxxxxxx
# 应用私钥
# ALIPAY_PRIVATE_KEY=你的应用私钥
# 支付宝公钥（推荐配置，用于验证异步通知签名）
# ALIPAY_PUBLIC_KEY=你的支付宝公钥
# 异步通知接收域名（生产环境必填，需公网可访问）
# ALIPAY_NOTIFY_HOST=https://your-domain.com

# ---- Tiger eSIM 合作伙伴 API（可选，留空则本地模拟下发）----
TIGER_CLIENT_ID=
TIGER_CLIENT_SECRET=
TIGER_BASE_URL=https://partner.tigeresims.com
TIGER_SMDP_ADDRESS=
# 已采购的卡片 ICCID 池，逗号分隔
TIGER_ICCIDS=

# ---- SMTP 邮件服务（支付成功/退款时向用户邮箱发送邮件）----
# 必填 SMTP_HOST / SMTP_USER / SMTP_PASS（163等邮箱需在邮箱后台开启SMTP并填授权码，非登录密码）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@163.com
# SMTP_PASS=你的授权码
# SMTP_FROM=your@163.com
# SMTP_FROM_NAME=YYeSim
