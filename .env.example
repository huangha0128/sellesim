# ===== 海豚 eSIM Docker 部署配置 =====
# 复制本文件为 .env 并修改后生效：cp .env.example .env（Windows: copy .env.example .env）

# ---------- Caddy 反向代理 ----------
# 配置域名后启用 HTTPS（使用手动生成的证书）；留空则监听 80 端口纯 HTTP
# 注意：证书仅覆盖该域名（如 www.bjyyxx.com），请使用证书实际包含的域名
CADDY_DOMAIN=

# 手动生成的证书目录（宿主机路径，默认 /serve/nginx/cert）
# 对应 certbot 的 /etc/letsencrypt 挂载，证书位于 ${CERT_DIR}/live/<域名>/
# 例如 /serve/nginx/cert/live/www.bjyyxx.com/fullchain.pem
CERT_DIR=/serve/nginx/cert

# 证书文件在容器内的路径（可选，默认按 certbot 目录结构自动拼接：
#   /etc/caddy/cert/live/<域名>/fullchain.pem 与 privkey.pem）
# 若证书非标准路径，可取消注释手动指定
# CADDY_CERT_FILE=/etc/caddy/cert/live/www.bjyyxx.com/fullchain.pem
# CADDY_KEY_FILE=/etc/caddy/cert/live/www.bjyyxx.com/privkey.pem

# ---------- 对外端口 ----------
# 后端 API 直连端口
SERVER_PORT=6501
# 管理后台直连端口（绕过 Caddy 时使用 http://<IP>:6500/backend/）
ADMIN_PORT=6500
# Caddy HTTP/HTTPS 端口
HTTP_PORT=80
HTTPS_PORT=443

# ---------- 后端环境变量 ----------
# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=your-jwt-secret-key-change-in-production

# ---- 支付宝支付配置（可选，不配置则使用 config.ts 中的默认值）----
# 支付宝应用 ID
# ALIPAY_APP_ID=202100xxxxxxx
# 应用私钥
# ALIPAY_PRIVATE_KEY=你的应用私钥
# 支付宝公钥（推荐配置，用于验证异步通知签名）
# ALIPAY_PUBLIC_KEY=你的支付宝公钥
# 异步通知接收域名（生产环境必填，需公网可访问）
# ALIPAY_NOTIFY_HOST=https://your-domain.com

# ---- Tiger eSIM 合作伙伴 API（可选，留空则本地模拟下发）----
TIGER_CLIENT_ID=
TIGER_CLIENT_SECRET=
TIGER_BASE_URL=https://partner.tigeresims.com
TIGER_SMDP_ADDRESS=
# 已采购的卡片 ICCID 池，逗号分隔
TIGER_ICCIDS=
