generator client {
  provider      = "prisma-client-js"
  // Explicitly declare the Alpine runtime platform so the engine is baked into the image
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Country {
  id            String    @id @default(uuid())
  code          String    @unique
  name          String
  en            String
  flag          String
  pinyin        String
  hot           Int       @default(0)
  priority      Int       @default(0) @map("display_priority")
  tier          Int       @default(1)
  cat           String
  intro         String
  tigerRegionId Int?      @map("tiger_region_id")
  iconUrl       String?   @map("icon_url")
  displayName   String?   @map("display_name") // custom group display-name; empty => default country name
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Admin login account for the management console.
// Password is stored as a salted scrypt hash, never in plain text.
// Admin JWTs share the same secret as miniapp user JWTs, so they are
// distinguished by type='admin' in the payload (see middleware/adminAuth.ts);
// a miniapp token must never be accepted by admin endpoints.
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  salt         String
  name         String?
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model User {
  id           String        @id @default(uuid())
  alipayUserId String        @unique @map("alipay_user_id")
  nickname     String        @default("")
  avatar       String        @default("")
  email        String        @default("")
  orders       Order[]
  esims        Esim[]
  externalApp  ExternalApp?
  subject      Subject?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// External app credentials for the open payment API.
// Each app maps to an internal synthetic user (alipayUserId='ext_<appId>').
// Orders created by the app are attached to that user for admin management.
model ExternalApp {
  id          String    @id @default(uuid())
  appId       String    @unique
  appSecret   String
  name        String
  callbackUrl String?   @map("callback_url")
  userId      String?   @unique @map("user_id")
  user        User?     @relation(fields: [userId], references: [id])
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Open platform v2: an onboarded subject (individual reseller / agent).
// Subjects are created only by the platform admin - there is no self signup.
// Each subject owns one or more API keys, an optional price override set,
// and all of its orders are scoped by subjectId.
model Subject {
  id                   String                 @id @default(uuid())
  name                 String
  username             String?                @unique @map("username") // partner portal login username (unique)
  passwordHash         String?                @map("password_hash") // scrypt hash (same scheme as AdminUser)
  salt                 String?
  status               String                 @default("active")
  callbackUrl          String?                @map("callback_url")
  defaultMarkupPercent Float?                 @map("default_markup_percent")
  quotaLimit           Float?                 @map("quota_limit") // max DEVICE debt threshold, set by admin
  usedQuota            Float                  @default(0) @map("used_quota") // cached used/unsettled quota (DEBT); source of truth is SubjectLedger
  balance              Float                  @default(0) // prepaid wallet balance (CNY), first source for order settlement
  splitPercent         Float?                 @map("split_percent") // partner split % placeholder (pending design decision, see docs/open-platform-v3-design.md L0/L1.3)
  contactName          String?                @map("contact_name")
  contactPhone         String?                @map("contact_phone")
  remark               String?
  userId               String?                @unique @map("user_id")
  user                 User?                  @relation(fields: [userId], references: [id])
  keys                 ApiKey[]
  prices               SubjectPackagePrice[]
  orders               Order[]
  deliveries           WebhookDelivery[]
  ledger               SubjectLedger[]
  recharges            SubjectRecharge[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

// Open platform v3: quota accounting (B2B credit distribution, see docs/open-platform-v3-design.md).
// Source of truth for each partner's used/unsettled quota (DEBT) and prepaid BALANCE.
// Direction is derived from type:
//   balance_debit  -> balance -= amount       (order settled from wallet balance first)
//   balance_refund -> balance += amount       (refund restores a balance-settled portion)
//   deposit_credit -> usedQuota -=, then balance += leftover (top-up/deposit offsets DEBT first)
//   order_debit    -> usedQuota += amount     (order placed on credit, over the balance)
//   refund_credit  -> usedQuota -= amount     (refund restores credit / refund pays off DEBT)
//   settle_credit  -> usedQuota -= amount     (partner paid off some credit)
//   adjust         -> usedQuota +=/amount per sign (manual admin adjustment)
model SubjectLedger {
  id         String   @id @default(uuid())
  subjectId  String   @map("subject_id")
  subject    Subject  @relation(fields: [subjectId], references: [id])
  type       String // order_debit | refund_credit | settle_credit | adjust | balance_debit | balance_refund | deposit_credit
  orderNo    String?  @map("order_no") // linked order (empty for non-order entries)
  refundNo   String?  @map("refund_no") // linked refund (for refund_credit)
  rechargeNo String?  @map("recharge_no") // linked recharge (for deposit_credit)
  amount     Float // absolute value; direction decided by type
  note       String?
  operatorId String?  @map("operator_id") // admin who performed a manual operation
  createdAt  DateTime @default(now())

  @@index([subjectId, createdAt])
}

// API credential issued to a subject. keyId is public and sent in X-Api-Key;
// keySecret never leaves the server and is used to sign write requests.
// keySecret must be stored in plain text because HMAC verification needs the
// original secret (same as ExternalApp.appSecret).
model ApiKey {
  id          String    @id @default(uuid())
  subjectId   String    @map("subject_id")
  subject     Subject   @relation(fields: [subjectId], references: [id])
  keyId       String    @unique @map("key_id")
  keySecret   String    @map("key_secret")
  name        String    @default("default")
  mode        String    @default("live")
  ipWhitelist String?   @map("ip_whitelist")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([subjectId])
}

// Per-subject package price override. Missing row means platform price.
// price wins over markupPercent; enabled=false hides the package from subject.
model SubjectPackagePrice {
  id            String   @id @default(uuid())
  subjectId     String   @map("subject_id")
  subject       Subject  @relation(fields: [subjectId], references: [id])
  pkgId         String   @map("pkg_id")
  price         Float?
  markupPercent Float?   @map("markup_percent")
  costPrice     Float?   @map("cost_price") // settle cost base for gross-profit split (pending design, docs/open-platform-v3-design.md L1.3)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([subjectId, pkgId])
  @@index([subjectId])
}

model Order {
  id            String    @id @default(uuid())
  orderNo       String    @unique
  pkgId         String
  countryCode   String?   @map("country_code")
  pkgName       String?   @map("pkg_name")
  pkgNameEn     String?   @map("pkg_name_en")
  gb            Int?
  days          Int?
  isUnlimited   Boolean   @default(false) @map("is_unlimited") // unlimited plan snapshot (throttled after high-speed quota)
  tigerPkgId    Int?      @map("tiger_pkg_id")
  tigerPid      String?   @map("tiger_pid")
  userId        String?   @map("user_id")
  user          User?     @relation(fields: [userId], references: [id])
  subjectId     String?   @map("subject_id") // open platform v2: owning subject
  subject       Subject?  @relation(fields: [subjectId], references: [id])
  apiKeyId      String?   @map("api_key_id") // open platform v2: key id used to place the order (audit)
  email         String
  payMethod     String    @default("alipay")
  status        String    @default("pending")
  price         Float
  paidAmount    Float?    @map("paid_amount") // actual paid via alipay notify buyer_pay_amount; refund uses this
  orderType     String    @default("new") @map("order_type") // new/renew
  targetEsimId  String?   @map("target_esim_id") // target esim for renew (only expired card can renew)
  paidAt        DateTime?
  alipayTradeNo String?   @map("alipay_trade_no")
  refundStatus  String?   @map("refund_status")
  refundReason  String?   @map("refund_reason")
  refundRequestedAt DateTime? @map("refund_requested_at")
  refundRejectReason String? @map("refund_reject_reason")
  refundRejectedAt DateTime? @map("refund_rejected_at")
  refundAmount  Float?    @map("refund_amount")
  refundTradeNo String?   @map("refund_trade_no")
  refundedAt    DateTime? @map("refunded_at")
  refundRejectCount Int   @default(0) @map("refund_reject_count") // refund requests rejected count (capped by settings maxRefundRejectCount)
  refundRequests RefundRequest[] // per-attempt refund application/review history
  extOrderNo    String?   @map("ext_order_no") // external order no for reconciliation
  webhookStatus String?   @default("none") @map("webhook_status") // none/pending/success/failed
  webhookSentAt DateTime? @map("webhook_sent_at")
  webhookRetryCount Int   @default(0) @map("webhook_retry_count")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  esim          Esim?
  refunds       Refund[]

  @@index([userId, extOrderNo])
  @@index([subjectId])
}

model Esim {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  userId         String?   @map("user_id")
  user           User?     @relation(fields: [userId], references: [id])
  activationCode String
  iccid          String
  smdp           String
  status         String    @default("pending")
  activatedAt    DateTime?
  expireAt       DateTime
  used         Float    @default(0)
  gb           Int?     @default(0) // cumulative gb snapshot
  days         Int?     @default(0) // cumulative days snapshot
  isUnlimited  Boolean  @default(false) @map("is_unlimited") // unlimited plan snapshot (throttled after high-speed quota)
  pkgName        String?   @map("pkg_name")
  pkgNameEn      String?   @map("pkg_name_en")
  countryCode    String?   @map("country_code")
  tigerPkgId     Int?      @map("tiger_pkg_id")
  tigerPid       String?   @map("tiger_pid")
  tigerBindingId Int?      @map("tiger_binding_id")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Card {
  id        String   @id @default(uuid())
  iccid     String   @unique
  remark    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ICCID blacklist: after refund-unbind the card is permanently banned from being reused to bind a package / place an order.
model CardBlacklist {
  id        String   @id @default(uuid())
  iccid     String   @unique
  reason    String   @default("refund") // refund: blacklisted after refund unbind; admin: manually blacklisted in admin panel
  createdAt DateTime @default(now())
}

// Local pricing override for TigerESIM packages.
// One row per tiger package id. price=null means use Tiger original price.
// onSale=false hides the package from public endpoints (miniapp / h5).
model PackagePrice {
  id         String   @id @default(uuid())
  tigerPkgId Int      @unique @map("tiger_pkg_id")
  price      Float?   @map("price")
  currency   String   @default("CNY") @map("currency")
  onSale     Boolean  @default(true) @map("on_sale")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Global key-value settings (e.g. display currency + usd/cny exchange rate).
model Setting {
  key   String @id
  value String
}

// Open platform v2: refund record. Supports full/partial and multiple refunds
// on the same order, replacing scattered refund fields on Order. Refunds are
// executed directly by the subject (self-service) after payment, no approval.
model Refund {
  id             String   @id @default(uuid())
  refundNo       String   @unique @map("refund_no")
  extRefundNo    String?  @map("ext_refund_no")
  orderId        String   @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id])
  subjectId      String   @map("subject_id")
  amount         Float
  status         String   @default("processing") // processing | success | failed
  reason         String?
  channelTradeNo String?  @map("channel_trade_no")
  failReason     String?  @map("fail_reason")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subjectId, extRefundNo])
  @@index([orderId])
}

// C2C user refund flow: one row per application attempt + review outcome.
// Tracks each time the user applies (requested) and the admin approve/reject
// so an order can be refunded multiple times (each rejected attempt is kept).
model RefundRequest {
  id           String    @id @default(uuid())
  orderId      String    @map("order_id")
  order        Order     @relation(fields: [orderId], references: [id])
  status       String    @default("requested") // requested | rejected | approved
  reason       String? // user-provided refund reason for this attempt
  rejectReason String?   @map("reject_reason") // admin reject reason (when rejected)
  operator     String? // admin who reviewed (rejected/approved)
  approvedAt   DateTime? @map("approved_at")
  rejectedAt   DateTime? @map("rejected_at")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([orderId])
}

// Open platform v2: webhook delivery record for subject callbacks.
// Replaces the single webhook* fields on Order so that multiple events
// (order.paid / order.refunded) and per-event retry history can be tracked.
// A delivery starts as pending, is attempted by the background poller with
// exponential backoff, and ends as success or failed (manual resend allowed).
model WebhookDelivery {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  subject     Subject  @relation(fields: [subjectId], references: [id])
  event       String   // order.paid | order.refunded
  orderNo     String   @map("order_no")
  extOrderNo  String?  @map("ext_order_no")
  refundNo    String?  @map("refund_no") // set for order.refunded (multi-refund)
  payload     String   @db.LongText // json webhook payload
  status      String   @default("pending") // pending | success | failed
  attempts    Int      @default(0)
  nextRetryAt DateTime? @map("next_retry_at")
  lastError   String?  @map("last_error") @db.Text
  lastErrorAt DateTime? @map("last_error_at")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectId])
  @@index([status, nextRetryAt])
}

// Open platform v3: subject wallet top-up order (prepaid recharge via Alipay H5).
// The partner pays CNY into the platform wallet; the credit is applied to the
// DEBT first (usedQuota -), any leftover goes to BALANCE (balance +).
// rechargeNo is the Alipay merchant order no (out_trade_no) for the deposit.
model SubjectRecharge {
  id            String    @id @default(uuid())
  rechargeNo    String    @unique @map("recharge_no")
  subjectId     String    @map("subject_id")
  subject       Subject   @relation(fields: [subjectId], references: [id])
  amount        Float // CNYC recharge amount
  status        String    @default("pending") // pending | paid
  alipayTradeNo String?   @map("alipay_trade_no")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([subjectId, createdAt])
}
