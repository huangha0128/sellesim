# ===== 支付宝支付配置 =====
# 已在 config.ts 中配置了默认值（开发/测试用），生产环境请通过环境变量覆盖
# 从支付宝开放平台（https://open.alipay.com）获取以下信息

# 支付宝应用 ID（开放平台 → 我的应用 → 应用信息）
# ALIPAY_APP_ID=202100xxxxxxx

# 应用私钥（开放平台 → 开发设置 → 接口加签方式 → 应用私钥）
# ALIPAY_PRIVATE_KEY=你的应用私钥

# 支付宝公钥（开放平台 → 开发设置 → 接口加签方式 → 支付宝公钥）
# 用于验证支付宝异步通知的签名，强烈建议配置
# ALIPAY_PUBLIC_KEY=你的支付宝公钥

# 支付宝异步通知接收地址（必须为公网可访问的 URL）
# 开发时可使用 ngrok 等工具暴露本地服务
# 例：ALIPAY_NOTIFY_HOST=https://your-domain.com
# 不配置时默认为 http://localhost:6660

# ===== Tiger eSIM 合作伙伴 API 配置 =====
# 复制本文件为 .env 并填入真实值后生效。
# 未配置时系统保持「本地模拟下发」，配置后支付成功将走 Tiger 真实下发。

# 合作伙伴平台分配的凭据（必填才会启用 Tiger 接入）
TIGER_CLIENT_ID=
TIGER_CLIENT_SECRET=

# Tiger API 基础地址（默认 https://partner.tigeresims.com）
TIGER_BASE_URL=https://partner.tigeresims.com

# eSIM SM-DP+ 地址（绑定套餐返回中未提供时的兜底值）
TIGER_SMDP_ADDRESS=

# 已采购的卡片 ICCID 池，逗号分隔（每笔订单会从中取一张未使用的卡）
# 推荐：通过后台「卡片管理」页面维护数据库卡片池，新增即时生效、无需重启；
# 此环境变量仅作为兼容兜底（与数据库卡片池自动合并去重）。
# 例：TIGER_ICCIDS=89000000000000000001,89000000000000000002
TIGER_ICCIDS=
