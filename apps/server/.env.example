# ===== Tiger eSIM 合作伙伴 API 配置 =====
# 复制本文件为 .env 并填入真实值后生效。
# 未配置时系统保持「本地模拟下发」，配置后支付成功将走 Tiger 真实下发。

# 合作伙伴平台分配的凭据（必填才会启用 Tiger 接入）
TIGER_CLIENT_ID=
TIGER_CLIENT_SECRET=

# Tiger API 基础地址（默认 https://partner.tigeresims.com）
TIGER_BASE_URL=https://partner.tigeresims.com

# eSIM SM-DP+ 地址（绑定套餐返回中未提供时的兜底值）
TIGER_SMDP_ADDRESS=

# 已采购的卡片 ICCID 池，逗号分隔（每笔订单会从中取一张未使用的卡）
# 例：TIGER_ICCIDS=89000000000000000001,89000000000000000002
TIGER_ICCIDS=
